{
  "name": "work4you-openai-audio-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Work4You Tool Gateway for speech-to-text and text-to-speech — OpenAI-compatible /v1/audio surface. Platform OPENAI_API_KEY never leaves this service.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.8.5",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
